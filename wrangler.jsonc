{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voca-study",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voca-study-db",
      "database_id": "44a2ee68-01f4-4960-865e-455ed0c958ba"
    }
  ]
}
